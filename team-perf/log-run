#!/usr/bin/env python3
"""Append one run line to team-perf/log/<agent>.jsonl (append-only). The folder is the one this script lives in
($TEAM_PERF_DIR overrides).
usage: log-run <Agent> <task> <ok|partial|fail|skipped> [--min N] [--retries N] [--corr N] [--kpi k=v ...] [--note TEXT]
       [--improve "change" --improve-kpi id --improve-status trial|kept|reverted] [--ts ISO]"""
import argparse, datetime, json, os, pathlib
p = argparse.ArgumentParser(); p.add_argument("agent"); p.add_argument("task"); p.add_argument("outcome", choices=["ok", "partial", "fail", "skipped"])
p.add_argument("--min", type=float); p.add_argument("--retries", type=int, default=0); p.add_argument("--corr", type=int, default=0)
p.add_argument("--kpi", action="append", default=[]); p.add_argument("--note", default=""); p.add_argument("--ts")
p.add_argument("--improve"); p.add_argument("--improve-kpi"); p.add_argument("--improve-status", default="trial")
a = p.parse_args()
def val(s):
    if s.lower() in ("true", "false"): return s.lower() == "true"
    if s.lower() in ("null", "none", ""): return None
    try: return float(s) if "." in s else int(s)
    except ValueError: return s
kpi = {k: val(v) for k, _, v in (x.partition("=") for x in a.kpi)}
ts = a.ts or datetime.datetime.now().astimezone().isoformat(timespec="seconds")
o = {"ts": ts, "agent": a.agent, "task": a.task, "outcome": a.outcome, "kpi": kpi, "minutes": a.min, "retries": a.retries, "corrections": a.corr, "note": a.note[:500],
     "improvement": {"change": a.improve, "kpi": a.improve_kpi, "status": a.improve_status} if a.improve else None}
base = pathlib.Path(os.environ.get("TEAM_PERF_DIR") or pathlib.Path(__file__).resolve().parent)
f = base / "log" / (a.agent.lower() + ".jsonl"); f.parent.mkdir(parents=True, exist_ok=True)
with f.open("a", encoding="utf-8") as fh: fh.write(json.dumps(o) + "\n")
print("logged", f)
